{
  "name": "adonis-authkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AuthKit — an AdonisJS OIDC/OAuth2 Authorization Server kit, OIDC client adapter, and React frontend ergonomics.",
  "license": "MIT",
  "author": "Davi de Carvalho",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "node scripts/import-smoke.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "version-packages": "changeset version && biome check --write .",
    "release": "pnpm build && pnpm changeset publish",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.6.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.6",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}

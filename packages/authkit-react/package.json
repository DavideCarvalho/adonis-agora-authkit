{
  "name": "@adonis-agora/authkit-react",
  "version": "0.19.1",
  "description": "Frontend ergonomics over AuthKit for AdonisJS + Inertia + React apps: a typed useAuth() hook, role-gating hooks and gating components.",
  "license": "MIT",
  "author": "dudousxd",
  "homepage": "https://github.com/DavideCarvalho/adonis-agora-authkit/tree/main/packages/authkit-react#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavideCarvalho/adonis-agora-authkit.git",
    "directory": "packages/authkit-react"
  },
  "bugs": {
    "url": "https://github.com/DavideCarvalho/adonis-agora-authkit/issues"
  },
  "keywords": [
    "adonisjs",
    "inertia",
    "react",
    "authentication",
    "authkit",
    "rbac",
    "authorization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": ["build", "styles.css"],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/index.js",
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --import=@poppinss/ts-exec bin/test.ts"
  },
  "peerDependencies": {
    "@inertiajs/react": "catalog:frontendPeers",
    "@simplewebauthn/browser": "catalog:frontendPeers",
    "@tanstack/react-query": "catalog:frontendPeers",
    "react": "catalog:frontendPeers",
    "react-dom": "catalog:frontendPeers"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    }
  },
  "dependencies": {
    "@adonis-agora/authkit-core": "workspace:*"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "catalog:adonis",
    "@inertiajs/react": "catalog:frontend",
    "@japa/assert": "catalog:",
    "@japa/runner": "catalog:",
    "@poppinss/ts-exec": "catalog:",
    "@tanstack/react-query": "catalog:frontend",
    "@types/node": "catalog:adonis",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "typescript": "catalog:frontend"
  }

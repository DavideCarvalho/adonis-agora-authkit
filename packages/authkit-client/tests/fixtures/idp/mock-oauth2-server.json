{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 300,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "*",
          "claims": {
            "sub": "ada",
            "email": "ada@example.com",
            "roles": ["ADMIN"]
          }
        }
      ]
    }
  ]
}

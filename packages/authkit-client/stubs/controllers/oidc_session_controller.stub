{{{
  exports({ to: app.makePath('app/controllers/oidc_session_controller.ts') })
}}}
import { inject } from '@adonisjs/core'
import type { HttpContext } from '@adonisjs/core/http'
import { AuthkitClientManager, OidcCallbackError } from '@adonis-agora/authkit-client'

/**
 * Login, callback and logout written out by hand. If you do not need to customise
 * them, registerOidcClient(router) registers the same three routes for you.
 */
@inject()
export default class OidcSessionController {
  constructor(protected authkit: AuthkitClientManager) {}

  async login({ session, response }: HttpContext) {
    // Fresh state + nonce + PKCE, against the endpoints discovered from the issuer.
    const { url, pending } = await this.authkit.createAuthorizationRequest()
    session.put('authkit_pkce', pending)
    return response.redirect(url)
  }

  async callback(ctx: HttpContext) {
    const pending = ctx.session.pull('authkit_pkce')
    try {
      // Checks state and iss, exchanges the code and validates the id_token (nonce included).
      const { tokens: tokenSet } = await this.authkit.completeAuthorization({
        pending,
        callbackParams: ctx.request.qs(),
      })
      // startSession (not session.put) drops any impersonation parked by a previous session.
      this.authkit.startSession(ctx, tokenSet)
    } catch (error) {
      // Stale callback, or the IdP sent the user back with an error (access_denied…).
      if (error instanceof OidcCallbackError && error.restartable) {
        return ctx.response.redirect('/auth/login')
      }
      throw error
    }
    return ctx.response.redirect('/')
  }

  async logout(ctx: HttpContext) {
    this.authkit.endSession(ctx)
    return ctx.response.redirect('/')
  }
}

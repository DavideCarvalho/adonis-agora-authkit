{
  "name": "@adonis-agora/authkit-vault-azure",
  "version": "1.0.1",
  "description": "Azure Key Vault keystore vault for the AuthKit JWKS keystore (createKeystoreVault).",
  "license": "MIT",
  "author": "dudousxd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-authkit.git",
    "directory": "packages/authkit-vault-azure"
  },
  "homepage": "https://davidecarvalho.github.io/agora/docs/authkit",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/adonis-agora-authkit/issues"
  },
  "keywords": [
    "adonisjs",
    "authkit",
    "keystore",
    "jwks",
    "azure",
    "key-vault",
    "tanstack-intent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "skills",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --import=@poppinss/ts-exec bin/test.ts"
  },
  "peerDependencies": {
    "@azure/keyvault-secrets": ">=4",
    "@azure/identity": ">=4"
  },
  "peerDependenciesMeta": {
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "catalog:adonis",
    "@japa/assert": "catalog:",
    "@japa/runner": "catalog:",
    "@poppinss/ts-exec": "catalog:",
    "@tanstack/intent": "0.5.6",
    "@types/node": "catalog:adonis",
    "typescript": "catalog:frontend"
  }
}

    {
      "commandName": "authkit:client",
      "description": "Manage OAuth clients: list, create, show, update, rotate-secret, revoke, delete.",
      "help": [
        "Actions:",
        "  list                 every client (--mcp: only MCP clients, registered or by metadata document)",
        "  create               a client; a confidential one prints its secret ONCE",
        "  show <id>            one client",
        "  update <id>          change its metadata (only the flags you pass)",
        "  rotate-secret <id>   a new secret, printed ONCE (the old one stops working)",
        "  revoke <id>          disable it and cut its grants/tokens in every account",
        "  delete <id>          delete it",
        "",
        "Examples:",
        "  node ace authkit:client list --json",
        "  node ace authkit:client list --mcp",
        "  node ace authkit:client create --client-id=my-spa --redirect-uri=https://app/cb --public",
        "  node ace authkit:client create --client-id=my-api --redirect-uri=https://api/cb --scope=openid --scope=email",
        "  node ace authkit:client create --client-id=my-mobile --native --redirect-uri=com.example.app:/oauth",
        "  node ace authkit:client create --client-id=worker-acme --partition=acme --capability=reports",
        "  node ace authkit:client update my-spa --redirect-uri=https://app/cb --redirect-uri=https://app/cb2",
        "  node ace authkit:client rotate-secret my-api --force",
        "  node ace authkit:client revoke https://claude.ai/oauth/claude-code-client-metadata --force",
        "",
        "Destructive actions (rotate-secret, revoke, delete) ask for confirmation unless --force."
      ],
      "namespace": "authkit",
      "aliases": [],
      "flags": [
        {
          "name": "clientId",
          "flagName": "client-id",
          "required": false,
          "type": "string",
          "description": "create: the client_id (default: random)."
        },
        {
          "name": "name",
          "flagName": "name",
          "required": false,
          "type": "string",
          "description": "create/update: client_name."
        },
        {
          "name": "redirectUri",
          "flagName": "redirect-uri",
          "required": false,
          "type": "array",
          "description": "create/update: redirect_uri (repeatable)."
        },
        {
          "name": "postLogoutUri",
          "flagName": "post-logout-uri",
          "required": false,
          "type": "array",
          "description": "create/update: post_logout_redirect_uri (repeatable)."
        },
        {
          "name": "grant",
          "flagName": "grant",
          "required": false,
          "type": "array",
          "description": "create/update: grant type (repeatable). Default: authorization_code + refresh_token."
        },
        {
          "name": "scope",
          "flagName": "scope",
          "required": false,
          "type": "array",
          "description": "create/update: a scope the client may ask for (repeatable). Default: any."
        },
        {
          "name": "public",
          "flagName": "public",
          "required": false,
          "type": "boolean",
          "description": "create/update: public client (no secret, PKCE)."
        },
        {
          "name": "confidential",
          "flagName": "confidential",
          "required": false,
          "type": "boolean",
          "description": "create/update: confidential client (with a secret)."
        },
        {
          "name": "native",
          "flagName": "native",
          "required": false,
          "type": "boolean",
          "description": "create: native app (RFC 8252): public, private-scheme/loopback redirects."
        },
        {
          "name": "backchannelLogoutUri",
          "flagName": "backchannel-logout-uri",
          "required": false,
          "type": "string",
          "description": "create/update: OIDC back-channel logout endpoint."
        },
        {
          "name": "clientSecret",
          "flagName": "client-secret",
          "required": false,
          "type": "string",
          "description": "create: use this client_secret instead of a random one."
        },
        {
          "name": "partition",
          "flagName": "partition",
          "required": false,
          "type": "string",
          "description": "create: service tenant partition (client_credentials only)."
        },
        {
          "name": "capability",
          "flagName": "capability",
          "required": false,
          "type": "array",
          "description": "create: service tenant capability (repeatable). Needs --partition."
        },
        {
          "name": "mcp",
          "flagName": "mcp",
          "required": false,
          "type": "boolean",
          "description": "list: only MCP clients (dynamic registration or metadata document)."
        },
        {
          "name": "force",
          "flagName": "force",
          "required": false,
          "type": "boolean",
          "description": "Do not ask for confirmation."
        },
        {
          "name": "json",
          "flagName": "json",
          "required": false,
          "type": "boolean",
          "description": "Machine-readable output."
        }
      ],
      "args": [
        {
          "name": "action",
          "argumentName": "action",
          "required": true,
          "description": "Action: list, create, show, update, rotate-secret, revoke, delete",
          "type": "string"
        },
        {
          "name": "id",
          "argumentName": "id",
          "required": false,
          "description": "Client id (show, update, rotate-secret, revoke, delete)",
          "type": "string"
        }
      ],
      "options": {
        "startApp": true
      },
      "filePath": "client.js"
    },
    {
      "commandName": "authkit:key",
      "description": "Manage the JWKS signing keys: list, generate, rotate, retire.",
      "help": [
        "Actions:",
        "  list           every key: kid, alg, status (active / verification / staged), created",
        "  generate       a new key, published in the JWKS but not signing yet (staged);",
        "                 the next `rotate` makes it the active key",
        "  rotate         a new active key (the staged one, if any); the previous ones stay",
        "                 published for verification (--keep, default 2) until their tokens expire",
        "  retire <kid>   remove a key that no longer signs: tokens signed by it stop validating",
        "",
        "Needs `jwks: { source: \"managed\", store: … }` in config/authkit.ts (file, lucid, redis or a",
        "vault). Other processes pick the new keys up through the keystore reload poll.",
        "",
        "Examples:",
        "  node ace authkit:key list --json",
        "  node ace authkit:key generate --alg=ES256",
        "  node ace authkit:key rotate --dry-run",
        "  node ace authkit:key rotate --keep=3",
        "  node ace authkit:key retire 0b5c… --force"
      ],
      "namespace": "authkit",
      "aliases": [],
      "flags": [
        {
          "name": "alg",
          "flagName": "alg",
          "required": false,
          "type": "string",
          "description": "generate: algorithm (RS256, PS256, ES256, EdDSA). Default: the configured one."
        },
        {
          "name": "keep",
          "flagName": "keep",
          "required": false,
          "type": "number",
          "description": "rotate: how many keys stay published (default 2)."
        },
        {
          "name": "retireOld",
          "flagName": "retire-old",
          "required": false,
          "type": "boolean",
          "description": "rotate: drop every old key right away (no grace period)."
        },
        {
          "name": "dryRun",
          "flagName": "dry-run",
          "required": false,
          "type": "boolean",
          "description": "rotate: show the plan without changing the keystore."
        },
        {
          "name": "force",
          "flagName": "force",
          "required": false,
          "type": "boolean",
          "description": "Do not ask for confirmation."
        },
        {
          "name": "json",
          "flagName": "json",
          "required": false,
          "type": "boolean",
          "description": "Machine-readable output."
        }
      ],
      "args": [
        {
          "name": "action",
          "argumentName": "action",
          "required": true,
          "description": "Action: list, generate, rotate, retire",
          "type": "string"
        },
        {
          "name": "kid",
          "argumentName": "kid",
          "required": false,
          "description": "Key id (retire)",
          "type": "string"
        }
      ],
      "options": {
        "startApp": true
      },
      "filePath": "key.js"
    },
    {
      "commandName": "authkit:purge",
      "description": "Delete expired/consumed tokens, grants, sessions and interactions, and unused dynamically registered clients.",
      "help": [
        "Removes what can no longer be used:",
        "  --tokens         expired and consumed access/refresh tokens, codes, device codes…",
        "  --grants         expired grants",
        "  --sessions       expired sessions",
        "  --interactions   expired login interactions",
        "  --clients        clients registered through /reg (e.g. MCP clients) longer ago than",
        "                   --older-than (default 30d) that have no live grant",
        "Without a kind flag, every kind is purged. Expired rows only need deleting on a database",
        "adapter (Redis expires them by itself). Safe to cron:",
        "",
        "  node ace authkit:purge --dry-run",
        "  node ace authkit:purge --clients --older-than=60d",
        "  node ace authkit:purge --json"
      ],
      "namespace": "authkit",
      "aliases": [],
      "flags": [
        {
          "name": "tokens",
          "flagName": "tokens",
          "required": false,
          "type": "boolean",
          "description": "Expired and consumed tokens and codes."
        },
        {
          "name": "grants",
          "flagName": "grants",
          "required": false,
          "type": "boolean",
          "description": "Expired grants."
        },
        {
          "name": "sessions",
          "flagName": "sessions",
          "required": false,
          "type": "boolean",
          "description": "Expired sessions."
        },
        {
          "name": "interactions",
          "flagName": "interactions",
          "required": false,
          "type": "boolean",
          "description": "Expired interactions."
        },
        {
          "name": "clients",
          "flagName": "clients",
          "required": false,
          "type": "boolean",
          "description": "Unused dynamically registered clients (see --older-than)."
        },
        {
          "name": "olderThan",
          "flagName": "older-than",
          "required": false,
          "type": "string",
          "description": "Clients registered longer ago than this (30d, 12h, 2w). Default 30d."
        },
        {
          "name": "dryRun",
          "flagName": "dry-run",
          "required": false,
          "type": "boolean",
          "description": "Count only; delete nothing."
        },
        {
          "name": "json",
          "flagName": "json",
          "required": false,
          "type": "boolean",
          "description": "Machine-readable output."
        }
      ],
      "args": [],
      "options": {
        "startApp": true
      },
      "filePath": "purge.js"
    },

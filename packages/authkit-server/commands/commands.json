    {
      "commandName": "authkit:settings:set",
      "description": "Grava (upsert) uma runtime setting em `auth_settings`. Valida shape para keys conhecidas.",
      "help": [
        "Grava ou atualiza uma setting pelo nome da key com o valor JSON fornecido.",
        "Para keys conhecidas do catálogo AuthKit, valida o shape antes de persistir.",
        "Keys desconhecidas são aceitas com aviso (stored as-is).",
        "Audita settings.updated com actor \"cli\".",
        "",
        "Exemplos:",
        "  node ace authkit:settings:set lockout '{\"enabled\":true,\"maxAttempts\":3,\"windowSec\":900}'",
        "  node ace authkit:settings:set session_policy '{\"rememberEnabled\":true,\"rememberDays\":14}'",
        "  node ace authkit:settings:set token_ttl '{\"accessTokenSec\":1800}'",
        "  node ace authkit:settings:set my_flag '{\"enabled\":true}'",
        "  node ace authkit:settings:set lockout '{\"enabled\":false}' --json",
        "",
        "Login de clientes MCP (automático) — desligar / voltar ao automático:",
        "  node ace authkit:settings:set mcp_clients '{\"enabled\":false}'",
        "  node ace authkit:settings:unset mcp_clients"
      ],
      "namespace": "authkit",
      "aliases": [],
      "flags": [
        {
          "name": "json",
          "flagName": "json",
          "required": false,
          "type": "boolean",
          "description": "Output em JSON machine-readable."
        }
      ],
      "args": [
        {
          "name": "key",
          "argumentName": "key",
          "required": true,
          "description": "Nome da setting (ex.: lockout, session_policy, token_ttl).",
          "type": "string"
        },
        {
          "name": "value",
          "argumentName": "value",
          "required": true,
          "description": "Valor JSON da setting (deve ser um objeto JSON válido).",
          "type": "string"
        }
      ],
      "options": {
        "startApp": true
      },
      "filePath": "settings_set.js"
    },

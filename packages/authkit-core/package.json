    "directory": "packages/authkit-core"
  },
  "bugs": {
    "url": "https://github.com/DavideCarvalho/adonis-authkit/issues"
  },
  "keywords": ["adonisjs", "oidc", "oauth2", "openid-connect", "authentication", "authkit"],
  "publishConfig": {
    "access": "public"
  },

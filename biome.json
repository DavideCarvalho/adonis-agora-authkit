{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.next",
      "!**/.source",
      "!**/coverage",
      "!**/.claude",
      "!**/*.stub",
      "!**/packages/authkit-server/src/host/assets/webauthn.js",
      "!**/apps/docs/out"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noEmptyInterface": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/agora-kit/ui/**", "**/agora-kit/hooks/**"],
      "linter": { "enabled": false }
    },
    {
      "includes": ["**/test/**", "**/*.spec.ts", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off",
            "noThenProperty": "off"
          },
          "complexity": {
            "noCommaOperator": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/authkit-server/ui/**",
        "**/packages/authkit-server/stubs/**",
        "**/apps/docs/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "preset": "none"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noAssignInExpressions": "off",
            "noMisleadingCharacterClass": "off"
          },
          "complexity": {
            "noUselessLoneBlockStatements": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.md", "**/*.yaml", "**/*.yml"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
